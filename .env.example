# Configuration contract only. This file must never contain real secret values.
# Supply secrets through the runtime environment, a CI/CD secret store, or an approved local
# .env file. Local .env files must not be committed.
ADGP_ENVIRONMENT=development
ADGP_LOG_LEVEL=INFO
ADGP_DATABASE_CONNECTION_STRING=
ADGP_GATEWAY_API_KEY=
ADGP_GATEWAY_BASE_URL=
ADGP_GATEWAY_MODEL_ALIAS=qwen-2.5-72b-instruct
ADGP_GATEWAY_TIMEOUT_SECONDS=30.0
ADGP_GATEWAY_CONNECT_TIMEOUT_SECONDS=10.0
ADGP_GATEWAY_MAX_RETRIES=1
ADGP_GATEWAY_TRUSTED_HOSTS=["localhost", "127.0.0.1", "::1", "gateway.internal", "litellm.internal"]
ADGP_AGENT_REQUEST_LIMIT=15
ADGP_AGENT_TOOL_CALLS_LIMIT=30
ADGP_AGENT_MAX_RESULT_SIZE=50000
ADGP_AGENT_TOTAL_TOKENS_LIMIT=100000
ADGP_AGENT_OUTPUT_TOKENS_LIMIT=16384
ADGP_AGENT_PARALLEL_TOOL_CALLS=false
